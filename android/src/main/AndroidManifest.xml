<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.example.accurate_step_counter">

  <!-- Required for TYPE_STEP_COUNTER / Activity Recognition on Android 10+ -->
  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>

  <!-- Required for foreground service -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
  <!-- Midnight rollover. Prefer SCHEDULE_EXACT_ALARM; code falls back to inexact
       if denied. Do NOT declare USE_EXACT_ALARM (Play policy: clocks/calendars). -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

  <!-- Soft-declare step hardware so installs still succeed on devices without it -->
  <uses-feature
      android:name="android.hardware.sensor.stepcounter"
      android:required="false"/>
  <uses-feature
      android:name="android.hardware.sensor.stepdetector"
      android:required="false"/>

  <application>
    <!-- Legacy sensors_plus FGS (fallback only) -->
    <service
        android:name=".StepCounterForegroundService"
        android:foregroundServiceType="health"
        android:exported="false"/>

    <!-- Primary TYPE_STEP_COUNTER FGS. health|dataSync: HEALTH when AR granted,
         DATA_SYNC fallback on fresh install before permission (Android 14+). -->
    <service
        android:name=".StepCounterService"
        android:foregroundServiceType="health|dataSync"
        android:exported="false"/>

    <receiver
        android:name=".MidnightReceiver"
        android:enabled="true"
        android:exported="false"/>

    <!-- Explicit component target for Activity Recognition PendingIntent -->
    <receiver
        android:name=".ActivityTransitionReceiver"
        android:enabled="true"
        android:exported="false"/>

    <receiver
        android:name=".BootReceiver"
        android:enabled="true"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
        <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
        <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
        <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
      </intent-filter>
    </receiver>
  </application>
</manifest>
